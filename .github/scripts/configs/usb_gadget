#!/sbin/openrc-run

name="usb_gadget"
description="USB Gadget setup for ADB and RNDIS"

depend() {
    need net localmount
    after modules udev
}

start() {
    ebegin "Running USB Gadget setup"
    /usr/local/bin/adbd &
    for i in {1..10}; do
        if pgrep -x "adbd" > /dev/null; then
            break
        fi
        sleep 3
    done
    
    for attempt in {1..3}; do
        UDC=$(ls -1 /sys/class/udc | head -n 1)
        if [ -n "$UDC" ]; then
            break
        fi
        sleep 1
    done
    
    if [ -z "$UDC" ]; then
        eend 1
        return 1
    fi
    
    for i in {1..30}; do
        echo "$UDC" > /sys/kernel/config/usb_gadget/g1/UDC
        if [ -s /sys/kernel/config/usb_gadget/g1/UDC ]; then
            break
        fi
        sleep 1
    done
    
    eend $?
}

stop() {
    ebegin "Stopping USB gadget"
    # Disable USB gadget
    echo "" > /sys/kernel/config/usb_gadget/g1/UDC
    
    # Stop ADB
    pkill adbd 2>/dev/null
    
    # Unmount functionfs
    umount /dev/usb-ffs/adb 2>/dev/null
    
    eend $?
} 
