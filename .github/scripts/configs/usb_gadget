#!/sbin/openrc-run

name="usb_gadget"
description="USB Gadget setup for ADB and RNDIS"

depend() {
    need net localmount
    after modules udev dbus networkmanager chronyd modemmanager
    use logger
}

start() {
    ebegin "Running USB Gadget setup"
    /usr/local/bin/adbd &
    sleep 3
    UDC=$(ls -1 /sys/class/udc | head -n 1)
    [ -n "$UDC" ] && echo "$UDC" > /sys/kernel/config/usb_gadget/g1/UDC
    
    eend $?
}

stop() {
    ebegin "Stopping USB gadget"
    # Disable USB gadget
    echo "" > /sys/kernel/config/usb_gadget/g1/UDC
    
    # Stop ADB
    killall adbd 2>/dev/null
    
    # Unmount functionfs
    umount /dev/usb-ffs/adb 2>/dev/null
    
    eend $?
} 